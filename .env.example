# ============================================================================
# MDC Healthcare ERP — production environment file
# ----------------------------------------------------------------------------
# 1. Copy this file to ".env"   (cp .env.example .env)
# 2. Fill in every value below. NEVER commit the real .env to Git.
# 3. Generate the four secrets with:   python generate_secrets.py
# ============================================================================

# --- Required secrets (each at least 32 characters). Production refuses to
#     start if any of these is missing or too short. ---
SECRET_KEY=CHANGE-ME-run-generate_secrets.py
JWT_SECRET_KEY=CHANGE-ME-run-generate_secrets.py
ENCRYPTION_KEY=CHANGE-ME-run-generate_secrets.py
DB_PASSWORD=CHANGE-ME-strong-database-password

# --- First administrator login (created on first launch). At least 12 chars.
#     Change it after your first login. ---
INITIAL_ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters

# --- Production flags (leave as-is for the Docker stack) ---
FLASK_CONFIG=production
COOKIE_SECURE=1
SESSION_COOKIE_SECURE=1
PREFERRED_URL_SCHEME=https

# --- Database. The bundled docker-compose sets this automatically from
#     DB_PASSWORD. Only set DATABASE_URL if you use an EXTERNAL PostgreSQL. ---
# DATABASE_URL=postgresql://mdc:the-db-password@your-db-host:5432/mdc_erp
